# Runs deploy/auto-deploy.sh once; started by training-deploy.timer. See docs/DEPLOY-PI.md.
# Assumes user "berdi-websites" and the repo at /home/berdi-websites/training-tracking.
[Unit]
Description=Training app: pull main and rebuild if it moved
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=berdi-websites
ExecStart=/home/berdi-websites/training-tracking/deploy/auto-deploy.sh
