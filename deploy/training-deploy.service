# Runs deploy/auto-deploy.sh once; started by training-deploy.timer. See docs/DEPLOY-PI.md.
# Assumes user "pi" and the repo at /home/pi/Training_tracking — adjust both if yours differ.
[Unit]
Description=Training app: pull main and rebuild if it moved
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=pi
ExecStart=/home/pi/Training_tracking/deploy/auto-deploy.sh
