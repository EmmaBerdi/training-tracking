<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs deploy/mac/pull-backups.sh daily at 12:00, and at login. A run missed while the Mac sleeps
  happens on wake. launchd expands neither ~ nor $HOME: install it with /Users/YOU replaced, as
  docs/DEPLOY-PI.md shows.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.training-tracking.pull-backups</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/YOU/IdeaProjects/Training_tracking/deploy/mac/pull-backups.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PI_HOST</key>
    <string>training-pi</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/training-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/training-backup.log</string>
</dict>
</plist>
