# Copy to deploy/.env on the Pi and fill in. deploy/.env is gitignored — it holds real secrets.

# The hostname the tunnel publishes, without scheme. Must be a subdomain of a domain that sits in
# your Cloudflare account, e.g. training.example.com.
APP_HOSTNAME=training.example.com

# From the Cloudflare dashboard: Zero Trust -> Networks -> Tunnels -> your tunnel -> the token in
# the Docker install command.
TUNNEL_TOKEN=

# Signs the access tokens the app hands out. Any leak here lets someone mint a token for any
# account, so generate it, don't invent it:  openssl rand -base64 48
JWT_SECRET=

# Postgres. The database is never exposed off the Pi, but the password still travels in backups.
DB_PASSWORD=
DB_NAME=training_tracking
DB_USER=training

# SMTP account that sends password reset codes ("Passwort vergessen?"). Optional: left empty, the
# reset form still answers, but no code ever arrives. Port 587 with STARTTLS.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender address; most providers only accept one you have verified with them.
MAIL_FROM=

# Host port nginx binds on 127.0.0.1, for checking the app from the Pi itself without the tunnel.
HOST_PORT=8090
